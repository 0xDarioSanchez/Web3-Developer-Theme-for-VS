{
  "name": "DS-Web3dev-theme",
  "displayName": "DS Web3 Developer Theme",
  "description": "Dark theme for Solidity and Rust",
  "version": "1.0.0",
  "publisher": "DarioFabSanchez",
  "icon": "images/icon.png",
  "preview": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/0xDarioSanchez/Web3-Developer-Theme-for-VS"
  },
  "license": "MIT",
  "keywords": [
    "themes",
    "theme",
    "solidity",
    "blockchain",
    "web3",
    "rust"
  ],
  "engines": {
    "vscode": "^1.89.0"
  },
  "categories": [
    "Themes",
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "solidity",
        "aliases": [
          "Solidity",
          "solidity"
        ],
        "extensions": [
          ".sol"
        ],
        "configuration": "./src/language-configuration.json"
      }
    ],
    "configurationDefaults": {
      "[solidity]": {
        "editor.semanticHighlighting.enabled": false
      }
    },
    "grammars": [
      {
        "language": "solidity",
        "scopeName": "source.solidity",
        "path": "./src/syntaxes/solidity.tmLanguage.json"
      }
    ],
    "themes": [
      {
        "label": "DS Web3 Developer",
        "uiTheme": "vs-dark",
        "path": "./src/themes/Sol-Auditor-color-theme.json"
      }
    ]
  }
}
